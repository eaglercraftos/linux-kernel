# EaglercraftOS arm64 fragment — merged over arch/arm64/configs/defconfig
# via: scripts/kconfig/merge_config.sh -m .config configs/config-arm64

# --- identity ---
CONFIG_LOCALVERSION="-eaglercraftos"
# CONFIG_LOCALVERSION_AUTO is not set

# --- scheduler / timers (sbc-friendly full preempt) ---
CONFIG_HZ_300=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_1000 is not set
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# --- memory / swap ---
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZBUD=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_CMA_SIZE_MBYTES=64

# --- cpu / power ---
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_SCMI_CPUFREQ=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_ARM64_VA_BITS_48=y

# --- networking ---
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_WIREGUARD=m

# --- filesystems ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y

# --- drm / gpu (pi + mali + virt) ---
CONFIG_DRM_V3D=m
CONFIG_DRM_VC4=m
CONFIG_DRM_PANFROST=m
CONFIG_DRM_LIMA=m
CONFIG_DRM_ETNAVIV=m
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_AMDGPU=m

# --- soc / boards ---
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BROADCOM=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_MESON=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_QCOM=y
CONFIG_RASPBERRYPI_FIRMWARE=y

# --- sound ---
CONFIG_SND_SOC=m
CONFIG_SND_BCM2835=m
CONFIG_SND_USB_AUDIO=m

# --- usb / input / gpio ---
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=m
CONFIG_USB_SERIAL=y
CONFIG_GPIO_RASPBERRYPI_EXP=m

# --- virt ---
CONFIG_KVM=m
CONFIG_VHOST_NET=m

# --- security ---
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_MAGIC_SYSRQ=y

# --- size / logging ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_PRINTK_TIME=n
CONFIG_LOG_BUF_SHIFT=18
